# ============================================================
# 银犁物流仓配一体化协同平台 —— 运行时环境变量
# Ubuntu 20.04 + 宝塔面板
#
# 用法：install.sh 会把本文件复制成 deploy/platform.env，
# 之后只需要编辑 platform.env（systemd 会自动读取）。
# 修改后执行：systemctl restart yinli-platform
# ============================================================

# ---- 监听地址 -------------------------------------------------
# 生产环境建议保持 127.0.0.1：只允许本机 Nginx 反向代理访问，
# 8787 端口不需要对公网开放（也不需要放行安全组）。
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8787

# ---- 数据目录 -------------------------------------------------
# 默认读取项目内的 data/demo。换成你自己的数据目录后，刷新页面即可生效，
# 不需要重启服务。目录内必须包含 6 个 CSV：
#   orders.csv trips.csv vehicles.csv docks.csv prep.csv charging.csv
# 表头参照 data/templates/ 下的同名文件；编码支持 UTF-8 / GBK。
# PLATFORM_DATA_DIR=/www/wwwroot/platform_v1/data/demo

# ---- 页面默认求解口径 -----------------------------------------
# heuristic = 与汇报材料一致的五情景口径（推荐，开箱默认）
# auto      = 优先 CP-SAT，失败回退启发式
# cpsat     = 只用 CP-SAT
PLATFORM_DEFAULT_SOLVER=heuristic
PLATFORM_COMPARE_SOLVER=heuristic

# ---- 求解资源限制 ---------------------------------------------
# 同时求解的请求数（超出排队）。1 核 2G 的服务器建议 1~2。
PLATFORM_MAX_CONCURRENT_SOLVES=2
# 排队等待上限（秒），超时返回 503。
PLATFORM_SOLVE_QUEUE_TIMEOUT=120
# 相同参数的求解结果缓存时间（秒），0 表示不缓存。
PLATFORM_SOLVE_CACHE_TTL=300
PLATFORM_SOLVE_CACHE_SIZE=64
# 单次 CP-SAT 求解时间上限（秒）与搜索线程数（0=按 CPU 核数自动）。
PLATFORM_CPSAT_MAX_TIME=10
PLATFORM_CPSAT_WORKERS=0

# ---- 请求限制 -------------------------------------------------
# POST /api/solve 请求体上限（字节）
PLATFORM_MAX_BODY_BYTES=65536

# ---- 日志 -----------------------------------------------------
# 1 = 打印访问日志（交给 journald 收集），0 = 只打印错误。
PLATFORM_ACCESS_LOG=1
